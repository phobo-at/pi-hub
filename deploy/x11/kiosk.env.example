# Kiosk-only runtime settings.
# Do not put provider credentials here; this file is inherited by the browser.

KIOSK_BROWSER=chromium
KIOSK_URL=http://127.0.0.1:8080
KIOSK_HEALTH_URL=http://127.0.0.1:8080/health
KIOSK_WAIT_TIMEOUT_SECONDS=45

# Optional alternatives:
# KIOSK_BROWSER=cog
# KIOSK_COG_PLATFORM=
# KIOSK_COG_ARGS=
